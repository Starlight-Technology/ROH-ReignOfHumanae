@inherits LayoutComponentBase
@implements IDisposable
@inject ROH.Launcher.Services.LauncherState LauncherState

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header class="top-row">
            <div class="top-status">
                <span class="status-dot @(LauncherState.IsUpdating ? "status-busy" : LauncherState.IsReadyToPlay ? "status-ready" : "status-warn")"></span>
                <span>@LauncherState.StatusMessage</span>
            </div>
            <div class="top-account">
                @(LauncherState.IsLoggedIn ? LauncherState.Username : "Offline")
            </div>
        </header>

        <article class="content">
            @Body
        </article>

        <AlertToast />
        <ConfirmDialog />
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        LauncherState.OnChange += StateChanged;
    }

    public void Dispose()
    {
        LauncherState.OnChange -= StateChanged;
    }

    void StateChanged() => InvokeAsync(StateHasChanged);
}
