@implements IDisposable
@using ROH.Launcher.Services
@inject AlertService AlertService

@if (_visible && _alert is not null)
{
    <div class="launcher-alert @GetAlertClass()" role="alert" aria-live="assertive">
        <div class="alert-icon">@GetAlertIcon()</div>
        <div class="alert-body">
            <strong>@_alert.Title</strong>
            <span>@_alert.Message</span>
        </div>
        <button type="button" class="alert-close" aria-label="Fechar alerta" @onclick="Close">x</button>
    </div>
}

@code {
    LauncherAlert? _alert;
    CancellationTokenSource? _autoCloseCts;
    bool _visible;

    protected override void OnInitialized()
    {
        AlertService.OnAlert += OnAlert;
    }

    public void Dispose()
    {
        AlertService.OnAlert -= OnAlert;
        _autoCloseCts?.Cancel();
        _autoCloseCts?.Dispose();
    }

    void Close()
    {
        _autoCloseCts?.Cancel();
        _visible = false;
        InvokeAsync(StateHasChanged);
    }

    string GetAlertClass() => _alert?.Kind == AlertKind.Error ? "alert-error" : "alert-success";

    string GetAlertIcon() => _alert?.Kind == AlertKind.Error ? "!" : "OK";

    void OnAlert(LauncherAlert alert)
    {
        _alert = alert;
        _visible = true;
        _autoCloseCts?.Cancel();
        _autoCloseCts?.Dispose();
        _autoCloseCts = new CancellationTokenSource();
        _ = AutoCloseAsync(_autoCloseCts.Token);
        InvokeAsync(StateHasChanged);
    }

    async Task AutoCloseAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken);
            _visible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }
}
