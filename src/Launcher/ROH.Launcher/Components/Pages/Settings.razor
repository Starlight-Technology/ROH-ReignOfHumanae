@page "/settings"
@inject ROH.Launcher.Services.AlertService AlertService
@inject ROH.Launcher.Services.LauncherState LauncherState
@inject ROH.Launcher.Services.SettingsService SettingsService

<div class="settings-page">
    <section class="settings-panel">
        <div class="panel-title">
            <span>Configuracoes</span>
            <strong>@(LauncherState.InstallDirectoryExists ? "Valido" : "Pendente")</strong>
        </div>

        <div class="form-row">
            <label class="form-label">Pasta de instalacao</label>
            <div class="input-action">
                <input class="form-control launcher-input" @bind="installDirectory" @bind:event="oninput" />
                <button class="btn btn-secondary" @onclick="Browse" disabled="@_saving">Selecionar</button>
            </div>
        </div>

        <div class="form-row">
            <label class="form-label">Executavel do jogo</label>
            <input class="form-control launcher-input" @bind="gameExecutableName" @bind:event="oninput" />
        </div>

        <div class="settings-summary">
            <div>
                <span>Versao instalada</span>
                <strong>@LauncherState.InstalledVersionLabel</strong>
            </div>
            <div>
                <span>Ultima atualizacao</span>
                <strong>@LauncherState.LastUpdatedLabel</strong>
            </div>
        </div>

        <div class="auth-actions">
            <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                @(_saving ? "Salvando..." : "Salvar")
            </button>
            <button class="btn btn-secondary" @onclick="OpenFolder" disabled="@_saving">Abrir pasta</button>
            <NavLink class="btn btn-secondary" href="/">Voltar</NavLink>
        </div>
    </section>
</div>

@code {
    string gameExecutableName = string.Empty;
    string installDirectory = string.Empty;
    bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await SettingsService.LoadAsync();
        await LauncherState.EnsureLoadedAsync();
        installDirectory = SettingsService.InstallDirectory;
        gameExecutableName = SettingsService.GameExecutableName;
    }

    async Task Browse()
    {
        string? picked = await SettingsService.PickInstallDirectoryAsync();
        if (!string.IsNullOrWhiteSpace(picked))
        {
            installDirectory = picked;
            LauncherState.RefreshInstallState();
        }
    }

    async Task OpenFolder()
    {
        await LauncherState.OpenInstallDirectoryAsync();
    }

    async Task Save()
    {
        if (_saving)
            return;

        _saving = true;
        try
        {
            SettingsService.InstallDirectory = installDirectory.Trim();
            SettingsService.GameExecutableName = string.IsNullOrWhiteSpace(gameExecutableName)
                ? "ReignOfHumanae.exe"
                : gameExecutableName.Trim();

            bool ok = await SettingsService.SaveAsync();
            LauncherState.RefreshInstallState();

            if (ok)
                await AlertService.ShowSuccess("Configuracoes", "Configuracoes salvas com sucesso.");
            else
                await AlertService.ShowError("Configuracoes", "Nao foi possivel validar a pasta de instalacao.");
        }
        finally
        {
            _saving = false;
        }
    }
}
