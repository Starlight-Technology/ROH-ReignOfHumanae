@page "/"
@inject ROH.Launcher.Services.LauncherState LauncherState
@using Microsoft.AspNetCore.Components

<div class="container mt-3">
    <h1>ROH Launcher</h1>

    <div class="mb-3">
        <label>Update Progress</label>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width:@LauncherState.UpdateProgress%">@String.Format("{0:0}%", LauncherState.UpdateProgress)</div>
        </div>
    </div>

    <div class="mb-3">
        @if (LauncherState.IsUpdating)
        {
            <button class="btn btn-warning" @onclick="StopUpdate">Stop Update</button>
        }
        else
        {
            <button class="btn btn-primary me-2" @onclick="StartUpdate">Start Update</button>
            <button class="btn btn-success" @onclick="StartGame">Play</button>
        }
    </div>

    <div class="mb-3">
        <strong>User:</strong>
        @if (LauncherState.IsLoggedIn)
        {
            <span class="ms-2">@LauncherState.Username</span>
            <button class="btn btn-link ms-2" @onclick="Logout">Logout</button>
        }
        else
        {
            <NavLink class="btn btn-outline-secondary ms-2" href="login">Login</NavLink>
        }
    </div>

    <div>
        <NavLink class="btn btn-outline-primary me-2" href="settings">Settings</NavLink>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        LauncherState.OnChange += StateChanged;
    }

    public void Dispose()
    {
        LauncherState.OnChange -= StateChanged;
    }

    private void StateChanged() => InvokeAsync(StateHasChanged);

    private void StartUpdate()
    {
        LauncherState.StartUpdate();
    }

    private void StopUpdate()
    {
        LauncherState.StopUpdate();
    }

    private void StartGame()
    {
        // Placeholder - in a real launcher this would start the game executable or switch to a different flow
        Console.WriteLine("Start Game pressed");
    }

    private void Logout()
    {
        LauncherState.Logout();
    }
}
