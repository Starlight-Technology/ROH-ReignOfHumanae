@page "/"
@inject ROH.Launcher.Services.LauncherState LauncherState
@inject ROH.Launcher.Services.UpdaterService UpdaterService
@inject ROH.Launcher.Services.SettingsService SettingsService
@using Microsoft.AspNetCore.Components
@using System
@using System.IO

<div class="container mt-3">
    <h1>ROH Launcher</h1>

    <div class="mb-3">
        <label>Update Progress</label>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width:@LauncherState.UpdateProgress%">@String.Format("{0:0}%", LauncherState.UpdateProgress)</div>
        </div>
    </div>

    <div class="mb-3">
        @if (LauncherState.IsUpdating)
        {
            <button class="btn btn-warning" @onclick="StopUpdate">Stop Update</button>
        }
        else
        {
            <button class="btn btn-primary me-2" @onclick="StartUpdate">Start Update</button>
            <button class="btn btn-success" @onclick="StartGame">Play</button>
        }
    </div>

    <div class="mb-3">
        <strong>User:</strong>
        @if (LauncherState.IsLoggedIn)
        {
            <span class="ms-2">@LauncherState.Username</span>
            <button class="btn btn-link ms-2" @onclick="Logout">Logout</button>
        }
        else
        {
            <NavLink class="btn btn-outline-secondary ms-2" href="login">Login</NavLink>
        }
    </div>

    <div>
        <NavLink class="btn btn-outline-primary me-2" href="settings">Settings</NavLink>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        LauncherState.OnChange += StateChanged;
    }

    public void Dispose()
    {
        LauncherState.OnChange -= StateChanged;
    }

    private void StateChanged() => InvokeAsync(StateHasChanged);

    private void StartUpdate()
    {
        // Start a real update process: get current version, list files, download them
        LauncherState.StartUpdate(async (progress, ct) =>
        {
            var version = await UpdaterService.GetCurrentVersionAsync(ct).ConfigureAwait(true);
            if (version is null)
            {
                progress.Report(100);
                return null;
            }

            var files = await UpdaterService.GetFilesForVersionAsync(version.Guid, ct, LauncherState.Token).ConfigureAwait(true);
            if (files is null)
            {
                progress.Report(100);
                return null;
            }

            string folder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "ROH", $"{version.Version}.{version.Release}.{version.Review}");
            try
            {
                await UpdaterService.DownloadFilesAsync(files, folder, progress, ct, LauncherState.Token).ConfigureAwait(true);
                return folder;
            }
            catch (Exception ex)
            {
                // show alert through LauncherState's alert service (LauncherState will also handle alerts)
                Console.WriteLine("Update failed: " + ex.Message);
                return null;
            }
        });
    }

    private void StopUpdate()
    {
        LauncherState.StopUpdate();
    }

    private void StartGame()
    {
        // Launch game from configured install directory
        _ = LauncherState.LaunchGameAsync(SettingsService.InstallDirectory);
    }

    private async Task Logout()
    {
        await LauncherState.Logout();
    }
}
