<!DOCTYPE html>

<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="bootstrap/css/bootstrap.css" />
    <link href="font-awesome/css/fontawesome.css" rel="stylesheet" />
    <link rel="stylesheet" href="font-awesome/css/fontawesome.css" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

    <link rel="stylesheet" href="@Assets["ROH.Site.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Corona/Corona.bundle.scp.css"]" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <CoronaThemeCascadingValue>
        <Routes @rendermode="InteractiveServer" />
    </CoronaThemeCascadingValue>

    <ReconnectModal />
    <script src="font-awesome/js/all.js"></script>
    <script src="sweetalert2/sweetalert2.js"></script>
    <script src="Interop/sweetalertInterop.js"></script>
    <script src="Interop/downloadFileInterop.js"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script>
        (function() {
            var lang = localStorage.getItem('lang');
            if (lang) {
                lang = lang.replace(/"/g, '');
                if (lang !== 'en') {
                    document.cookie = ".AspNetCore.Culture=c=" + lang + "|uic=" + lang + ";path=/;max-age=" + (365 * 86400);
                }
            }
        })();
    </script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.setCultureCookie = function(culture) {
            var cookie = ".AspNetCore.Culture=c=" + culture + "|uic=" + culture + ";path=/;max-age=" + (365 * 86400);
            document.cookie = cookie;
        };
    </script>
</body>

</html>
