@using MudBlazor
@inject IStringLocalizer<SharedResource> _loc

<MudPaper Class="pa-6">
    <MudText>@_loc["Shared.HelloWorld"]</MudText>

    <MudButton OnClick="Close">
        @_loc["Shared.Close"]
    </MudButton>
</MudPaper>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    void Close() => MudDialog.Close();
}
