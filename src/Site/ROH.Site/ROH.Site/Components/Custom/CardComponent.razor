@namespace ROH.Site.Components.Custom

<CoronaCard Title="@Header"
            Class="@CssClass"
            HeaderTextAlign="CoronaTextAlign.Center"
            ContentTextAlign="CoronaTextAlign.Left">
    @ChildContent
</CoronaCard>

@code {
    [Parameter]
    public string? Header { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "roh-card";
}
