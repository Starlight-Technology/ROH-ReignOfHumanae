@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Interfaces.Helpers
@using System.ComponentModel.DataAnnotations
@inject ICustomAuthenticationStateProvider CustomAuthStateProvider
@inject NavigationManager Navigation

@namespace ROH.Site.Components.Custom

@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;

    private bool IsAuthorized { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CustomAuthStateProvider.Initialize();
            IsAuthorized = !string.IsNullOrWhiteSpace(await CustomAuthStateProvider.GetToken());
            StateHasChanged();
        }
    }
}

@if (IsAuthorized)
{
    @ChildContent
}
else
{
    <CardComponent Header="Access Denied">
        <CoronaStack Spacing="1rem" FullWidth="true">
            <p>You are not authorized to view this page.</p>
            <p>If you believe this is an error, please contact support.</p>
            <CoronaButton Variant="CoronaButtonVariant.Outlined"
                          OnClick="@(() => Navigation.NavigateTo("/login"))">
                Login
            </CoronaButton>
        </CoronaStack>
    </CardComponent>
}
