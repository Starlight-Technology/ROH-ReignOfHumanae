@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Interfaces.Helpers
@using System.ComponentModel.DataAnnotations
@inject ICustomAuthenticationStateProvider CustomAuthStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> _loc

@namespace ROH.Site.Components.Custom

@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;

    private bool IsAuthorized { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CustomAuthStateProvider.Initialize();
            IsAuthorized = !string.IsNullOrWhiteSpace(await CustomAuthStateProvider.GetToken());
            StateHasChanged();
        }
    }
}

@if (IsAuthorized)
{
    @ChildContent
}
else
{
    <CardComponent Header="@_loc["Shared.AccessDenied"]">
        <CoronaStack Spacing="1rem" FullWidth="true">
            <p>@_loc["Shared.NotAuthorized"]</p>
            <p>@_loc["Shared.ContactSupport"]</p>
            <CoronaButton Variant="CoronaButtonVariant.Outlined"
                          OnClick="@(() => Navigation.NavigateTo("/login"))">
                @_loc["Nav.Login"]
            </CoronaButton>
        </CoronaStack>
    </CardComponent>
}
