@page "/magic-skills"
@using ROH.Site.Components.Custom
@inject IStringLocalizer<SharedResource> _loc

<div class="card-container">
    <CardComponent Header="@_loc["MagicSkills.Title"]">

        <p>
            @_loc["MagicSkills.Intro"]
        </p>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["MagicSkills.Development"]">
            <p>
                @_loc["MagicSkills.DevelopmentText"]
            </p>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["MagicSkills.Trees"]">
            <p>
                @_loc["MagicSkills.TreesText"]
            </p>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["MagicSkills.Channeling"]">
            <p>
                @_loc["MagicSkills.ChannelingText"]
            </p>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["MagicSkills.Affinity"]">
            <p>
                @_loc["MagicSkills.AffinityText"]
            </p>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["MagicSkills.Categories"]">
            <p>
                @_loc["MagicSkills.CategoriesText"]
            </p>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["MagicSkills.CrossDisciplinary"]">
            <p>
                @_loc["MagicSkills.CrossDisciplinaryText"]
            </p>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["MagicSkills.Progression"]">
            <p>
                @_loc["MagicSkills.ProgressionText"]
            </p>
        </CardComponent>
    </CardComponent>
</div>
