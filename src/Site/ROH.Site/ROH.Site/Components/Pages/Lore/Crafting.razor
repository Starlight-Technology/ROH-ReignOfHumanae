@page "/crafting"
@using ROH.Site.Components.Custom
@inject IStringLocalizer<SharedResource> _loc

<div class="card-container">
    <CardComponent Header="@_loc["Crafting.Title"]">
        <p>
            @_loc["Crafting.Intro"]
        </p>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["Crafting.RaceSpecific"]">
            <p>
                @_loc["Crafting.RaceSpecificText"]
            </p>
            <ul>
                <li><strong>@_loc["Crafting.UnderstandStrengths"]</strong> @_loc["Crafting.UnderstandStrengthsText"]</li>
                <li><strong>@_loc["Crafting.Collaborate"]</strong> @_loc["Crafting.CollaborateText"]</li>
            </ul>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["Crafting.MasterBlacksmiths"]">
            <p>
                @_loc["Crafting.MasterBlacksmithsText"]
            </p>
            <ul>
                <li><strong>@_loc["Crafting.AspireToMaster"]</strong> @_loc["Crafting.AspireToMasterText"]</li>
                <li><strong>@_loc["Crafting.BuildReputation"]</strong> @_loc["Crafting.BuildReputationText"]</li>
            </ul>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["Crafting.MaterialRequirements"]">
            <p>
                @_loc["Crafting.MaterialRequirementsText"]
            </p>
            <ul>
                <li><strong>@_loc["Crafting.GatherResources"]</strong> @_loc["Crafting.GatherResourcesText"]</li>
                <li><strong>@_loc["Crafting.ParticipateQuests"]</strong> @_loc["Crafting.ParticipateQuestsText"]</li>
                <li><strong>@_loc["Crafting.EngageTrade"]</strong> @_loc["Crafting.EngageTradeText"]</li>
            </ul>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["Crafting.Mechanics"]">
            <p>
                @_loc["Crafting.MechanicsText"]
            </p>
            <ul>
                <li><strong>@_loc["Crafting.MasterMiniGames"]</strong> @_loc["Crafting.MasterMiniGamesText"]</li>
                <li><strong>@_loc["Crafting.OptimizeTime"]</strong> @_loc["Crafting.OptimizeTimeText"]</li>
            </ul>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["Crafting.SkillImprovement"]">
            <p>
                @_loc["Crafting.SkillImprovementText"]
            </p>
            <ul>
                <li><strong>@_loc["Crafting.PracticeRegularly"]</strong> @_loc["Crafting.PracticeRegularlyText"]</li>
                <li><strong>@_loc["Crafting.SetGoals"]</strong> @_loc["Crafting.SetGoalsText"]</li>
            </ul>
        </CardComponent>

        <div class="card-divider"></div>

        <CardComponent Header="@_loc["Crafting.Customization"]">
            <p>
                @_loc["Crafting.CustomizationText"]
            </p>
            <ul>
                <li><strong>@_loc["Crafting.ExperimentEnchantments"]</strong> @_loc["Crafting.ExperimentEnchantmentsText"]</li>
                <li><strong>@_loc["Crafting.FocusVersatility"]</strong> @_loc["Crafting.FocusVersatilityText"]</li>
            </ul>
        </CardComponent>
    </CardComponent>
</div>
