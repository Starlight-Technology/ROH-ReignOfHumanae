@page "/world-bosses"
@using ROH.Site.Components.Custom
@inject IStringLocalizer<SharedResource> _loc

<CardComponent Header="@_loc["WorldBosses.Title"]">
    <CardComponent Header="@_loc["WorldBosses.Elyndria"]">
        <div class="row align-items-center mb-4">
            <div class="col-sm-4">
                <img class="img-fluid boss-image" src="../Images/elyndria.jfif" />
            </div>
            <div class="col-sm-8">
                <p>
                    @_loc["WorldBosses.ElyndriaText"]
                </p>
            </div>
        </div>
    </CardComponent>

