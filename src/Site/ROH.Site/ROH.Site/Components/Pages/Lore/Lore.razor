@page "/lore"
@using ROH.Site.Components.Custom
@inject IStringLocalizer<SharedResource> _loc

<CardComponent Header="@_loc["Home.Welcome"]">
    <div class="jumbotron">
        <p class="lead">@_loc["Home.Lead"]
        </p>
    </div>

    <CardComponent Header="@_loc["Lore.Overview"]">
        <p>
            @_loc["Home.Intro"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>
    
    <CardComponent Header="@_loc["Lore.AgeOfStrife"]">
        <p>
            @_loc["Lore.AgeOfStrifeText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.SentinelAccord"]">
        <p>
            @_loc["Lore.SentinelAccordText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.WorldBosses"]">
        <p>
            @_loc["Lore.WorldBossesText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.RoleOfKings"]">
        <p>
            @_loc["Lore.RoleOfKingsText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.Guardians"]">
        <p>
            @_loc["Lore.GuardiansText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.ItemCrafting"]">
        <p>
            @_loc["Lore.ItemCraftingText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.MagicAndSkills"]">
        <p>
            @_loc["Lore.MagicAndSkillsText"]
        </p>
    </CardComponent>

</CardComponent>
