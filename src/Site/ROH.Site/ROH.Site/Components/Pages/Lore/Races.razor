@page "/races"
@using ROH.Site.Components.Custom
@inject IStringLocalizer<SharedResource> _loc

<CardComponent Header="@_loc["Races.Title"]">

    <CardComponent Header="@_loc["Races.Humans"]">
        <p>
            @_loc["Races.HumansText"]
        </p>
    </CardComponent>

    <CardComponent Header="@_loc["Races.Elves"]">
        <p>
            @_loc["Races.ElvesText"]
        </p>
    </CardComponent>

    <CardComponent Header="@_loc["Races.Dwarfs"]">
        <p>
            @_loc["Races.DwarfsText"]
        </p>
    </CardComponent>

    <CardComponent Header="@_loc["Races.Demons"]">
        <p>
            @_loc["Races.DemonsText"]
        </p>
    </CardComponent>

</CardComponent>
