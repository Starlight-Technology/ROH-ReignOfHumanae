@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SharedResource> _loc

<PageTitle>@_loc["Error.Title"]</PageTitle>

<h1 class="text-danger">@_loc["Error.Heading"]</h1>
<h2 class="text-danger">@_loc["Error.Description"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@_loc["Error.RequestId"]:</strong> <code>@RequestId</code>
    </p>
}

<h3>@_loc["Error.DevelopmentMode"]</h3>
<p>
    @((MarkupString)_loc["Error.DevelopmentInfo"].Value)
</p>
<p>
    @((MarkupString)_loc["Error.DevelopmentWarning"].Value)
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
