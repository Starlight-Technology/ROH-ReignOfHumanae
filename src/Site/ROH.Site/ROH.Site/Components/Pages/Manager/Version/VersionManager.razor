@page "/Manager/Version/VersionManager"

@using Newtonsoft.Json;
@using Api;
@using ROH.Site.Components.Custom
@using ROH.StandardModels.Version;
@inject IStringLocalizer<SharedResource> _loc

<AuthorizeComponent>
    <CardComponent Header="@_loc["Version.Manager"]">
        <CoronaTabs Variant="CoronaTabsVariant.Segmented" LazyRender="true">
            <CoronaTabItem Header="@_loc["Version.Current"]">
                <Manager.Version.Components.CurrentVersionComponent />
            </CoronaTabItem>

            <CoronaTabItem Header="@_loc["Version.Versions"]">
                <Manager.Version.Components.AllVersionsComponent />
            </CoronaTabItem>

            <CoronaTabItem Header="@_loc["Version.NewVersion"]">
                <Manager.Version.Components.NewVersionComponent />
            </CoronaTabItem>
        </CoronaTabs>
    </CardComponent>
</AuthorizeComponent>
