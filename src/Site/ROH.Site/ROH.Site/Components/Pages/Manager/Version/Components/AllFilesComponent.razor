@namespace Manager.Version.Components
@using Newtonsoft.Json;

@using ROH.Site.Components.Custom
@using ROH.Site.Helpers.Types
@using ROH.Site.Interfaces.Api
@using ROH.Site.Interfaces.Helpers
@using ROH.StandardModels.File
@using ROH.StandardModels.Response;
@using ROH.StandardModels.Version
@using ROH.Utils.Helpers;

@inject IDownloadFileService _downloadFile
@inject IVersionFileService _versionFileService;
@inject IRohAlertService _sweetAlert;
@inject IStringLocalizer<SharedResource> _loc

<CardComponent Header="@_loc["Version.Files"]">

    @if (isLoading)
    {
        <div style="text-align:center">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only"></span>
            </div>
        </div>
    }

    else if (gameVersionFileListModels.Any())
    {
        <MudPaper Class="roh-table-container" Elevation="3">
            <MudTable T="GameVersionFileListModel"
                      Dense
                      Hover
                      Items="@gameVersionFileListModels">

                <HeaderContent>
                    <MudTh>@_loc["Shared.Name"]</MudTh>
                    <MudTh>@_loc["Shared.Path"]</MudTh>
                    <MudTh>@_loc["Shared.Size"]</MudTh>
                    <MudTh>@_loc["Shared.Active"]</MudTh>
                    <MudTh />
                </HeaderContent>

                <RowTemplate Context="file">
                    <MudTd>@GetDisplayName(file.Name)</MudTd>
                    <MudTd>@GetDisplayPath(file)</MudTd>
                    <MudTd>@file.Size</MudTd>
                    <MudTd>
                        <CoronaBadge Content="@(file.Active ? _loc["Shared.Active"] : _loc["Shared.Inactive"])"
                                     Color="@(file.Active ? CoronaColorSemantic.Success : CoronaColorSemantic.Neutral)"
                                     Variant="CoronaBadgeVariant.Outlined" />
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                       Color="Color.Primary"
                                       OnClick="@(() => DownloadFile(file))" />
                    </MudTd>
                </RowTemplate>

            </MudTable>
        </MudPaper>
    }
    else
    {
        <div class="roh-empty-state">@_loc["Version.NoFiles"]</div>
    }

</CardComponent>

@code {

    private bool isLoading = true;
    private DefaultResponse? apiResponse = null;
    private readonly List<GameVersionFileListModel> gameVersionFileListModels = new();

    [Parameter]
    public string VersionGuid { get; set; } = string.Empty;

    protected override async void OnInitialized()
    {
        await base.OnInitializedAsync();
        await GetAllVersion();
    }

    private async Task GetAllVersion()
    {
        isLoading = true;
        gameVersionFileListModels.Clear();
        apiResponse = await _versionFileService.GetAllVersionFiles(VersionGuid);

        if (apiResponse != null && !apiResponse.HttpStatus.IsSuccessStatusCode())
            await _sweetAlert.ShowResponse(apiResponse);

        else if (apiResponse != null && apiResponse.ObjectResponse != null && apiResponse.HttpStatus.IsSuccessStatusCode())
        {
            var result = JsonConvert.DeserializeObject<ICollection<dynamic>>(apiResponse.ObjectResponse.ToString() ?? "");

            if (result != null)
            {
                var versionList = result.ToList();

                foreach (var item in versionList)
                {
                    GameVersionFileModel gameVersionFileModel = JsonConvert.DeserializeObject<GameVersionFileModel>(item.ToString());

                    if (gameVersionFileModel != null)
                    {
                        GameVersionFileListModel gameVersionFileListModel = gameVersionFileModel.ToListModel();
                        gameVersionFileListModels?.Add(gameVersionFileListModel);
                    }
                }
            }
        }

        isLoading = false;
        StateHasChanged();

    }

    private async Task DownloadFile(GameVersionFileListModel file)
    {
        DefaultResponse? response = await _versionFileService.DownloadVersionFile(file.FileGuid.ToString());

        if (response is null)
        {
            await _sweetAlert.Show(_loc["Shared.Error"], _loc["Shared.NoResponse"], RohAlertType.Error);
            return;
        }

        if (response.ObjectResponse != null)
        {
            GameFileModel fileModel = response.ResponseToModel<GameFileModel>();
            await _downloadFile.Download(fileModel);
            return;
        }

        await _sweetAlert.ShowResponse(response);
    }

    private static string GetDisplayName(string name)
    {
        string relativeName = NormalizeDisplayPath(name);
        string fileName = Path.GetFileName(relativeName.Replace('/', Path.DirectorySeparatorChar));
        return string.IsNullOrWhiteSpace(fileName) ? name : fileName;
    }

    private static string GetDisplayPath(GameVersionFileListModel file)
    {
        if (!string.IsNullOrWhiteSpace(file.Path))
            return file.Path;

        string relativeName = NormalizeDisplayPath(file.Name);
        string? directory = Path.GetDirectoryName(relativeName.Replace('/', Path.DirectorySeparatorChar));
        return string.IsNullOrWhiteSpace(directory)
            ? "Root"
            : directory.Replace(Path.DirectorySeparatorChar, '/');
    }

    private static string NormalizeDisplayPath(string value) => value
        .Replace('\\', '/')
        .Trim('/');
}
