@namespace Manager.Version.Components

@using ROH.Site.Components.Custom
@using ROH.Site.Interfaces.Api
@using ROH.Site.Interfaces.Helpers
@using ROH.StandardModels.Version
@using ROH.Utils.Helpers;

@inject IRohAlertService _sweetAlert;
@inject IVersionService _versionService;
@inject IStringLocalizer<SharedResource> _loc

<CardComponent Header="@_loc["Version.NewVersion"]">
    <CoronaStack Spacing="1rem" FullWidth="true">
        <VersionSummaryComponent Version="@ParsedVersion"
                                 Release="@ParsedRelease"
                                 Review="@ParsedReview"
                                 ShowStatus="true" />

        <CoronaStack Direction="CoronaStackDirection.Row" Spacing=".75rem">
            <CoronaInput Label="@_loc["Shared.Version"]" @bind-Value="inputVersion" Type="number" Min="0" />
            <CoronaInput Label="@_loc["Shared.Release"]" @bind-Value="inputRelease" Type="number" Min="0" />
            <CoronaInput Label="@_loc["Shared.Review"]" @bind-Value="inputReview" Type="number" Min="0" />
        </CoronaStack>

        <CoronaButton Color="CoronaColorSemantic.Primary"
                      Variant="CoronaButtonVariant.Filled"
                      OnClick="CreateNewVersion">
            @_loc["Version.CreateNew"]
        </CoronaButton>
    </CoronaStack>

</CardComponent>

@code {

    private string inputVersion = "0";
    private string inputRelease = "0";
    private string inputReview = "0";

    private int ParsedVersion => int.TryParse(inputVersion, out var v) ? v : 0;
    private int ParsedRelease => int.TryParse(inputRelease, out var r) ? r : 0;
    private int ParsedReview => int.TryParse(inputReview, out var rv) ? rv : 0;

    private readonly GameVersionModel currentVersion = new()
    {
        Version = 0,
        Release = 0,
        Review = 0
    };


    private async Task CreateNewVersion()
    {
        GameVersionModel model = new() { Version = ParsedVersion, Release = ParsedRelease, Review = ParsedReview };

        var response = await _versionService.CreateNewVersion(model);

        if (response != null)
            await _sweetAlert.ShowResponse(response);
    }
}
