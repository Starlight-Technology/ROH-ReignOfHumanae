@namespace Manager.Version.Components
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using ROH.Site.Components.Custom
@using ROH.Site.Interfaces.Api
@using ROH.Site.Interfaces.Helpers
@using ROH.StandardModels.Paginator;
@using ROH.StandardModels.Response;
@using ROH.StandardModels.Version;
@using ROH.Utils.Helpers;

@inject IVersionService _versionService;
@inject IRohAlertService _sweetAlert;
@inject NavigationManager Navigation;

<CardComponent Header="Versions">
    <div class="roh-version-filters">
        <MudSelect T="string"
                   Label="Version Type"
                   Variant="Variant.Outlined"
                   Class="roh-field"
                   Value="@selectedVersionType"
                   ValueChanged="OnVersionTypeChanged">

            @foreach (var type in versionTypes)
            {
                <MudSelectItem Value="@type">
                    @type
                </MudSelectItem>
            }

        </MudSelect>

        <CoronaInput Label="Search"
                     Placeholder="v1.2.3"
                     @bind-Value="searchText" />

        <CoronaInput Label="Version Date"
                     Type="date"
                     @bind-Value="versionDateFilter" />

        <CoronaButton Color="CoronaColorSemantic.Neutral"
                      Variant="CoronaButtonVariant.Outlined"
                      TextColor="#e6d3a1"
                      BorderColor="rgba(201, 162, 77, 0.45)"
                      OnClick="ClearFilters">
            Clear
        </CoronaButton>
    </div>

    @if (isLoadingCurrentVersion)
    {
        <div style="text-align:center">
            <div class="spinner-border text-primary" role="status">
                <span class="sr-only"></span>
            </div>
        </div>
    }

    else if (FilteredVersions.Any())
    {
        <MudPaper Class="roh-table-container" Elevation="3">
            <MudTable T="GameVersionModel"
                      Dense
                      Hover
                      Items="@FilteredVersions">

                <HeaderContent>
                    <MudTh>Version</MudTh>
                    <MudTh>Release</MudTh>
                    <MudTh>Review</MudTh>
                    <MudTh>Version Date</MudTh>
                    <MudTh>Release Date</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh />
                </HeaderContent>

                <RowTemplate Context="version">
                    <MudTd>
                        <CoronaBadge Content="@GetVersionLabel(version)"
                                     Variant="CoronaBadgeVariant.Soft" />
                    </MudTd>
                    <MudTd>@version.Release</MudTd>
                    <MudTd>@version.Review</MudTd>
                    <MudTd>@FormatDate(version.VersionDate)</MudTd>
                    <MudTd>@FormatDate(version.ReleaseDate)</MudTd>
                    <MudTd>
                        <CoronaBadge Content="@(version.Released ? "Released" : "Review")"
                                     Color="@(version.Released ? CoronaColorSemantic.Success : CoronaColorSemantic.Warning)"
                                     Variant="CoronaBadgeVariant.Outlined" />
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       OnClick="@(() => NavigateToDetails(version.Guid))" />
                    </MudTd>
                </RowTemplate>

            </MudTable>

            <CoronaStack Direction="CoronaStackDirection.Row"
                         Justify="CoronaStackJustify.SpaceBetween"
                         Wrap="CoronaStackWrap.Wrap"
                         Spacing=".75rem"
                         Class="roh-pagination-actions">

                <CoronaButton Variant="CoronaButtonVariant.Outlined"
                              Disabled="@IsFirstPage"
                              OnClick="@PreviousPage">
                    Previous
                </CoronaButton>

                <span class="roh-pagination-page">Page @CurrentPage of @Math.Max(TotalPages, 1)</span>

                <CoronaButton Variant="CoronaButtonVariant.Outlined"
                              Disabled="@IsLastPage"
                              OnClick="@NextPage">
                    Next
                </CoronaButton>

            </CoronaStack>
        </MudPaper>
    }
    else
    {
        <div class="roh-empty-state">No versions match the current filters.</div>
    }

</CardComponent>

@code {
    private readonly List<string> versionTypes = new()
    {
        "All Versions",
        "Released Versions"
    };

    private string selectedVersionType = "All Versions";
    private string searchText = string.Empty;
    private string versionDateFilter = string.Empty;
    private bool isLoadingCurrentVersion = true;
    private List<GameVersionModel>? PagedGameVersions = new();
    private int TotalPages = 0;
    private readonly int PageSize = 10;
    private int CurrentPage = 1;
    private bool IsFirstPage => CurrentPage == 1;
    private bool IsLastPage => CurrentPage >= Math.Max(TotalPages, 1);
    private DefaultResponse? apiResponse = null;
    private IEnumerable<GameVersionModel> FilteredVersions => (PagedGameVersions ?? [])
        .Where(MatchesSearch)
        .Where(MatchesDate);

    private async Task PreviousPage()
    {
        if (!IsFirstPage)
        {
            CurrentPage--;
            await GetAllVersion(page: CurrentPage, take: PageSize);
        }
    }

    private async Task NextPage()
    {
        if (!IsLastPage)
        {
            CurrentPage++;
            await GetAllVersion(page: CurrentPage, take: PageSize);
        }
    }

    private async Task OnVersionTypeChanged(string value)
    {
        selectedVersionType = value;
        CurrentPage = 1;
        await GetAllVersion(take: PageSize);
    }

    private Task ClearFilters()
    {
        searchText = string.Empty;
        versionDateFilter = string.Empty;
        return Task.CompletedTask;
    }

    protected override async void OnInitialized()
    {
        await base.OnInitializedAsync();
        await GetAllVersion(take: PageSize);
    }

    private async Task GetAllVersion(int page = 1, int take = 10)
    {
        isLoadingCurrentVersion = true;
        PagedGameVersions = new List<GameVersionModel>();
        apiResponse = null;
        if (selectedVersionType == "All Versions")
            apiResponse = await _versionService.GetAllVersionsPaginated(page, take);
        else if (selectedVersionType == "Released Versions")
            apiResponse = await _versionService.GetAllReleasedVersionsPaginated(page, take);

        if (apiResponse != null)
        {
            if (!apiResponse.HttpStatus.IsSuccessStatusCode())
                await _sweetAlert.ShowResponse(apiResponse);

            else if (apiResponse.ObjectResponse != null && apiResponse.HttpStatus.IsSuccessStatusCode())
            {
                var result = JsonConvert.DeserializeObject<PaginatedModel>(apiResponse.ObjectResponse.ToString() ?? "");

                if (result != null)
                {
                    TotalPages = result.TotalPages ?? 0;

                    if (result.ObjectResponse != null)
                    {
                        var versionList = result.ObjectResponse.ToList();

                        foreach (var item in versionList)
                        {
                            var gameVersionModel = JsonConvert.DeserializeObject<GameVersionModel>(item.ToString());

                            if (gameVersionModel != null)
                            {
                                PagedGameVersions?.Add(gameVersionModel);
                            }
                        }
                    }
                }
            }
        }

        isLoadingCurrentVersion = false;
        StateHasChanged();

    }

    private bool MatchesSearch(GameVersionModel version)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        string query = searchText.Trim();
        string versionLabel = GetVersionLabel(version);

        return versionLabel.Contains(query, StringComparison.OrdinalIgnoreCase)
            || version.Version.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            || version.Release.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            || version.Review.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            || FormatDate(version.VersionDate).Contains(query, StringComparison.OrdinalIgnoreCase)
            || FormatDate(version.ReleaseDate).Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesDate(GameVersionModel version)
    {
        if (string.IsNullOrWhiteSpace(versionDateFilter))
            return true;

        return DateTime.TryParse(versionDateFilter, out DateTime selectedDate)
            && version.VersionDate.Date == selectedDate.Date;
    }

    private static string GetVersionLabel(GameVersionModel version) => $"v{version.Version}.{version.Release}.{version.Review}";

    private static string FormatDate(DateTime? date) => date?.ToShortDateString() ?? "Pending";

    private void NavigateToDetails(Guid guid) => Navigation.NavigateTo($"/Manager/Version/VersionDetails/{guid}");
}
