@rendermode InteractiveServer
@page "/"
@using ROH.Site.Components.Custom
@inject IStringLocalizer<SharedResource> _loc

<CardComponent Header="@_loc["Home.Welcome"]">
    <p class="lead">
        @_loc["Home.Lead"]
    </p>
    <CoronaStack Direction="CoronaStackDirection.Row"
                 Wrap="CoronaStackWrap.Wrap"
                 Spacing=".5rem">
        <CoronaBadge Content="@_loc["Home.Mmorpg"]" Variant="CoronaBadgeVariant.Soft" />
        <CoronaBadge Content="@_loc["Home.FourRaces"]" Variant="CoronaBadgeVariant.Outlined" />
        <CoronaBadge Content="@_loc["Home.WorldBosses"]" Variant="CoronaBadgeVariant.Soft" Color="CoronaColorSemantic.Warning" />
    </CoronaStack>
    <p>
        @_loc["Home.Intro"]
    </p>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Home.WorldOfHumanae"]">
        <p>
            @_loc["Home.WorldOfHumanaeText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Races.Title"]">
        <div class="expansion-panel">
            <b>@_loc["Races.Humans"]</b>
            <p>
                @_loc["Races.HumansText"]
            </p>
        </div>
        <div class="expansion-panel">
            <b>@_loc["Races.Elves"]</b>
            <p>
                @_loc["Races.ElvesText"]
            </p>
        </div>
        <div class="expansion-panel">
            <b>@_loc["Races.Dwarfs"]</b>
            <p>
                @_loc["Races.DwarfsText"]
            </p>
        </div>
        <div class="expansion-panel">
            <b>@_loc["Races.Demons"]</b>
            <p>
                @_loc["Races.DemonsText"]
            </p>
        </div>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.AgeOfStrife"]">
        <p>
            @_loc["Lore.AgeOfStrifeText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.SentinelAccord"]">
        <p>
            @_loc["Lore.SentinelAccordText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.WorldBosses"]">
        <p>
            @_loc["Lore.WorldBossesText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.RoleOfKings"]">
        <p>
            @_loc["Lore.RoleOfKingsText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.Guardians"]">
        <p>
            @_loc["Lore.GuardiansText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.ItemCrafting"]">
        <p>
            @_loc["Lore.ItemCraftingText"]
        </p>
    </CardComponent>

    <div class="card-divider"></div>

    <CardComponent Header="@_loc["Lore.MagicAndSkills"]">
        <p>
            @_loc["Lore.MagicAndSkillsText"]
        </p>
    </CardComponent>
</CardComponent>
