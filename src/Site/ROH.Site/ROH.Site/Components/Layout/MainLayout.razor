@using ROH.Site.Helpers.Components.Layout
@using ROH.Site.Interfaces.Helpers
@using ROH.Site.Resources
@implements IDisposable
@inherits LayoutComponentBase
@inject DrawerState DrawerState
@inject ICustomAuthenticationStateProvider CustomAuthStateProvider
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> _loc

<MudThemeProvider Theme="@RohTheme.Dark" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CoronaPageHeader Title="@_loc["Layout.Title"]"
                  Height="64px"
                  Class="roh-corona-header"
                  Actions="@HeaderActions" />

<div class="roh-corona-shell @(DrawerState.Open ? "drawer-open" : "drawer-closed")">
    <CoronaDrawer Open="@DrawerState.Open"
                  OpenChanged="@DrawerState.SetOpen"
                  Overlay="false"
                  Width="280px"
                  TopOffset="64px"
                  Padding="1rem"
                  Class="roh-corona-drawer">
        <CoronaStack Spacing="1rem" FullWidth="true">
            <p class="roh-drawer-title">@_loc["Layout.DrawerTitle"]</p>
            <CoronaNavMenu Items="@NavigationItems"
                           Padding="0"
                           ItemPadding=".85rem 1rem"
                           Class="roh-corona-nav" />
        </CoronaStack>
    </CoronaDrawer>

    <main class="roh-corona-content">
        <div class="roh-content-shell">
            @Body
        </div>
    </main>
</div>

@code {
    private bool IsAuthorized { get; set; }

    private IReadOnlyList<CoronaNavItem> NavigationItems =>
    [
        new CoronaNavItem { Text = _loc["Nav.Home"], Url = "/" },
        IsAuthorized
            ? new CoronaNavItem { Text = _loc["Nav.Manager"], Url = "/Manager/Version/VersionManager" }
            : new CoronaNavItem { Text = _loc["Nav.Login"], Url = "/login" },
        new CoronaNavItem { Text = _loc["Nav.Crafting"], Url = "/crafting" },
        new CoronaNavItem { Text = _loc["Nav.Lore"], Url = "/lore" },
        new CoronaNavItem { Text = _loc["Nav.MagicSkills"], Url = "/magic-skills" },
        new CoronaNavItem { Text = _loc["Nav.Races"], Url = "/races" },
        new CoronaNavItem { Text = _loc["Nav.WorldBosses"], Url = "/world-bosses" }
    ];

    private RenderFragment HeaderActions =>
        @<CoronaStack Direction="CoronaStackDirection.Row"
                      Align="CoronaStackAlign.Center"
                      Spacing=".5rem">
            <button type="button"
                    class="roh-header-icon-button"
                    title="@_loc["Layout.Menu"]"
                    @onclick="DrawerState.Toggle">
                <CoronaIcon Name="bars" Color="currentColor" />
            </button>

            <LanguageSwitcher />

            <button type="button"
                    class="roh-header-icon-button"
                    title="@_loc["Layout.Account"]"
                    @onclick="@(() => Nav.NavigateTo("/login"))">
                <CoronaIcon Name="user" Color="currentColor" />
            </button>
        </CoronaStack>;

    protected override void OnInitialized()
    {
        DrawerState.OnChange += HandleDrawerChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CustomAuthStateProvider.Initialize();
            IsAuthorized = !string.IsNullOrWhiteSpace(await CustomAuthStateProvider.GetToken());
            StateHasChanged();
        }
    }

    private void HandleDrawerChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DrawerState.OnChange -= HandleDrawerChanged;
    }
}
